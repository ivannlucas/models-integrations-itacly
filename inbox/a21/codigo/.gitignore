# -----------------------------
# Python / local env
# -----------------------------
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Temporary helper scripts generated during checks
.tmp_*.py

# -----------------------------
# Data: exclude heavy/non-essential by default
# -----------------------------
# Never upload raw sources
/data/raw/

# Exportaciones intermedias de ingest_weather_gee.py (diario/semanal/pivot/
# checkpoints parciales): regenerables, la fuente de verdad ya queda en
# data/processed/auto/utils/climate_monthly_provinces.csv (Paso 1).
/data/external/

# Exclude large intermediate processed folders, except the small subset of
# manual inputs actually consumed by Pasos 2/5 (ppagados + superficies), kept
# so a fresh clone can reproduce those steps end to end. Excludes GEE climate
# raw exports (heavy, only Paso 1 opcional) and other unused legacy folders.
/data/processed/manual/*
!/data/processed/manual/ppagados1/
!/data/processed/manual/ppagados1_2/
!/data/processed/manual/ppagados2/
!/data/processed/manual/ppagados3/
!/data/processed/manual/ppagados4/
!/data/processed/manual/superficies_provincial_processed/
# Within ppagados1_2, keep only the raw originals: *_fixed.csv is regenerated by
# reshape_indpag4_timeseries.py / fix_ppagados_date_columns.py (Paso 2).
/data/processed/manual/ppagados1_2/*_fixed*.csv
# Within superficies_provincial_processed, exclude the generated yearly totals:
# regenerated by unify_superficies_by_year.py (Paso 5) and already tracked in
# data/processed/auto/utils/superficies_provinciales/.
/data/processed/manual/superficies_provincial_processed/*/total_*.csv

# Exclude heavyweight derived dataset not required for from-processed reproducibility

# -----------------------------
# Keep essential reproducibility inputs/outputs
# -----------------------------
!/data/processed/
!/data/processed/

!/data/predictions/
!/data/predictions/*.csv
!/data/predictions/*.txt

!/data/splits/
!/data/splits/*.csv

!/models/artifacts/
!/models/artifacts/*.joblib
!/models/artifacts/model_metadata.json
!/models/artifacts/experiment_results_*.json
!/models/artifacts/experiment_summary_*.json

# Keep compact metric reports, skip heavy images
/models/metrics/*.png
!/models/metrics/full_report.json
!/models/metrics/summary_performance.md
!/models/metrics/reproducibility/
!/models/metrics/reproducibility/reproducibility_report.json
# Exclude the entire documents folder from version control
/documents/
correcciones_modelo_21.md
/plans
/.claude
