# Forzar LF en archivos JSON y Python para que el SHA-256 sea identico
# en Windows (autocrlf=true) y Linux/Mac. Sin esto, Windows saca CRLF
# en checkout y el hash del archivo local difiere del blob de git.
*.json   text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.csv    text eol=lf
*.txt    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.joblib binary
*.png    binary
*.pdf    binary
