# .env.example
STORAGE_BUCKET=
CUSTOM_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CUSTOM_REGION=

# Límites de descompresión de los ZIP de /train y /predict por lotes
# (app/infrastructure/archive.py). Si se superan, la API responde 413.
# Tamaño total descomprimido, en bytes (10 GiB).
ARCHIVE_MAX_TOTAL_BYTES=10737418240
# Número máximo de ficheros en el ZIP.
ARCHIVE_MAX_FILES=200000
# Ratio máximo descomprimido/comprimido por fichero (detecta zip bombs; los ficheros < 1 MiB están exentos).
ARCHIVE_MAX_RATIO=200

#MODEL=ml3-wine-disease-pest-forecast